{
    "schemaVersion": 1,
    "id": "cream",
    "version": "${version}",
    "name": "Cream",
    "description": "A fabric mod that adds a minimalist, retro-style computer to Minecraft, running a custom instruction set!",
    "authors": [
        "elydre",
        "asqel"
    ],
    "contact": {
        "homepage": "https://github.com/elydre/cream",
        "sources": "https://github.com/elydre/cream"
    },
    "license": "CC0-1.0",
    "icon": "assets/cream/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "io.github.elydre.cream.CreamMain"
        ],
        "client": [
            "io.github.elydre.cream.client.CreamMainClient"
        ],
        "fabric-datagen": [
            "io.github.elydre.cream.client.datagen.ExempleModDatagen"
        ]
    },
    "mixins": [
        "cream.mixins.json",
        {
            "config": "cream.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "~26.3",
        "java": ">=25",
        "fabric-api": "*"
    }
}